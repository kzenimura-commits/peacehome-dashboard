# ========== 必須：認証パスワード ==========
# ダッシュボードURLにアクセスする際のパスワード。任意の文字列でOK。
APP_PASSWORD=your-strong-password-here

# ダッシュボードで表示されるBasic認証のユーザー名。デフォルトは "peacehome"
APP_USERNAME=peacehome

# ========== 必須：Google Sheets 認証情報 ==========
# GCPのサービスアカウントJSONから抜粋。詳細はSETUP.md参照。
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# サービスアカウントの秘密鍵。JSONの private_key 全体を貼り付ける（改行は \n のままでOK）
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"

# ========== 必須：スプレッドシートID ==========
# 44期 工事管理チェックシート のID（URLの/d/と/edit/の間）
PROJECTS_SHEET_ID=1TKuFVKpB9b6CcMHVxleMlslB9mNRgYid3N73t3xZV_I

# 管理部実績管理（原価管理）のID
BUDGET_SHEET_ID=17f1Go57v3aIhlj8VU0WbiVNX0hjo9McWce-lPf4vmpU

# 週報【設計・IC事業部】のID
WEEKLY_SHEET_ID=1JFdpH3eHNQzBG0gB0NS26-5acZtllhgs

# ========== オプション：シート内のシート名 ==========
# 期を切り替える際に変更。デフォルトはこの値でOK
PROJECTS_SHEET_TABS=【注文】44期,【ひなた】44期,【建売・モデル】44期
BUDGET_SHEET_TAB=原価管理（新築）

# ========== オプション：キャッシュ制御 ==========
# 何秒間APIレスポンスをキャッシュするか（デフォルト300秒=5分）
CACHE_TTL_SECONDS=300
